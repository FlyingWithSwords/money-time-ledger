    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:tessdata": "node scripts/fetch-tessdata.mjs",
    "quote-proxy": "node server/quote-proxy.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "fflate": "^0.8.2",
    "nanoid": "^5.0.7",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tesseract.js": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
