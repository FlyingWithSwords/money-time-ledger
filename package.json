{
  "name": "money-time-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "快记账：把每笔支出换算成还要工作多久的本地记账 PWA（无后端、无账号、数据只存本机）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
